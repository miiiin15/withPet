<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/outside_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margin_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/top_to_header"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title_text_view"
            style="@style/TitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이름을\n입력해주세요" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:layout_weight="2"
        android:orientation="vertical">

        <com.withpet.mobile.ui.custom.CustomInput
            android:id="@+id/password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:hint="비밀번호"
            android:inputType="textPassword"
            android:visibility="gone"
            app:errorText="8자 이상 16자 이하, 하나 이상의 숫자 포함 해주세요" />

        <LinearLayout
            android:id="@+id/id_form_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.withpet.mobile.ui.custom.CustomInput
                android:id="@+id/login_id_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="이메일"
                android:inputType="text"
                app:errorText="이메일 형식에 맞게 입력해주세요" />

            <com.withpet.mobile.ui.custom.CustomButton
                android:id="@+id/check_duplication_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:text="중복" />
        </LinearLayout>

        <com.withpet.mobile.ui.custom.CustomSelect
            android:id="@+id/gender_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:hint="성별"
            android:visibility="gone" />

        <com.withpet.mobile.ui.custom.CustomInput
            android:id="@+id/age_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:hint="나이"
            android:inputType="number"
            android:visibility="gone"
            app:errorText="올바른 나이를 입력해주세요" />

        <com.withpet.mobile.ui.custom.CustomInput
            android:id="@+id/nick_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:hint="이름"
            android:inputType="text"
            app:errorText="2글자 이상 입력해주세요" />

    </LinearLayout>

    <com.withpet.mobile.ui.custom.CustomButton
        android:id="@+id/sign_up_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/bottom_to_button"
        android:text="다음" />
</LinearLayout>

